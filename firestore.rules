rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Ganti dengan email admin (huruf kecil). Boleh lebih dari satu: ['a@gmail.com', 'b@gmail.com']
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['emailadmin@gmail.com'];
    }

    // Satu dokumen per anggota. Anggota hanya mengelola dokumennya sendiri.
    // Admin hanya bisa membaca, tidak bisa mengubah atau menghapus data anggota.
    match /planners/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.state is string
        && request.resource.data.state.size() < 900000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
  }
}
